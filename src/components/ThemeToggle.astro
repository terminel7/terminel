<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch to dark mode"
  title="Toggle color theme"
>
  <span class="theme-toggle__sun" aria-hidden="true"></span>
  <span class="theme-toggle__moon" aria-hidden="true"></span>
</button>

<script>
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  const currentTheme = (): Theme => root.dataset.theme === "dark" ? "dark" : "light";

  const updateThemeColor = (theme: Theme) => {
    document.querySelector<HTMLMetaElement>("meta[name='theme-color']")
      ?.setAttribute("content", theme === "dark" ? "#0d0d0c" : "#f6f6f3");
  };

  const hasStoredTheme = () => {
    try {
      return Boolean(localStorage.getItem("terminel-theme"));
    } catch {
      return false;
    }
  };

  updateThemeColor(currentTheme());

  buttons.forEach((button) => {
    if (button.dataset.initialized === "true") return;
    button.dataset.initialized = "true";

    const updateLabel = (theme: Theme) => {
      button.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
    };

    updateLabel(currentTheme());

    button.addEventListener("click", () => {
      const nextTheme: Theme = currentTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = nextTheme;
      try {
        localStorage.setItem("terminel-theme", nextTheme);
      } catch {
        // The visual preference still applies for this page view.
      }
      updateLabel(nextTheme);
      updateThemeColor(nextTheme);

      window.dispatchEvent(new CustomEvent("terminel-theme-change", { detail: nextTheme }));
    });
  });

  media.addEventListener("change", (event) => {
    if (hasStoredTheme()) return;
    const theme: Theme = event.matches ? "dark" : "light";
    root.dataset.theme = theme;
    updateThemeColor(theme);
    buttons.forEach((button) => {
      button.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
    });
    window.dispatchEvent(new CustomEvent("terminel-theme-change", { detail: theme }));
  });
</script>
