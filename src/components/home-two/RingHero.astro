---
import { Pause, Play } from "@lucide/astro";
import { projects } from "../../lib/projects";
import { sitePath } from "../../lib/paths";
import OutboundArrow from "../OutboundArrow.astro";
---

<section class="ring-hero section" data-ring-hero aria-labelledby="home-two-title">
  <div class="container ring-hero__intro">
    <p class="eyebrow">Creative Direction / Design / Development</p>
    <h1 id="home-two-title">Building brands and intelligent <span class="mobile-hidden-word">digital </span>experiences that move hearts—and move the needle.</h1>
  </div>

  <div class="ring-hero__stage" data-ring-stage role="img" aria-label="Portfolio artwork arranged in a circular gallery">
    <div class="ring-hero__fallback" aria-hidden="true">
      {projects.map((project, index) => (
        <img src={sitePath(project.hero)} alt="" data-ring-image decoding="async" loading={index < 3 ? "eager" : "lazy"} />
      ))}
    </div>
    <canvas class="ring-hero__canvas" data-ring-canvas aria-hidden="true"></canvas>
  </div>

  <div class="container ring-hero__footer">
    <p>Selected Work</p>
    <div class="ring-hero__actions">
      <a href="#work">Explore Work <OutboundArrow /></a>
      <button class="ring-hero__pause" type="button" data-ring-pause aria-label="Pause gallery motion" aria-pressed="false" title="Pause gallery motion" hidden>
        <Pause class="ring-hero__pause-icon" size={17} stroke-width={1.6} aria-hidden="true" />
        <Play class="ring-hero__play-icon" size={17} stroke-width={1.6} aria-hidden="true" />
      </button>
    </div>
  </div>
</section>

<script>
  import { mountRingGallery } from "../../scripts/ring-gallery";
  const hero = document.querySelector<HTMLElement>("[data-ring-hero]");
  if (hero) void mountRingGallery(hero);
</script>
