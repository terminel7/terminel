---
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import { sitePath } from "../../lib/paths";
import OutboundArrow from "../OutboundArrow.astro";

// Keep image selection, responsive focal points, and captions together.
const slides = [
  { name: "3D / AI", image: "Header_Image_1", description: "Emerging technology shaped into expressive, human-centered experiences.", href: "/capabilities/", cta: "Explore Capabilities", position: "50% 45%", mobile: "44% 50%" },
  { name: "Streaming", image: "Header_Image_2", description: "Digital strategy and design for a platform built around meaningful content.", href: "/work/streaming/", cta: "View Project", position: "50% 46%", mobile: "76% 50%" },
  { name: "Fintech", image: "Header_Image_3", description: "A connected brand experience brought to life on an industry stage.", href: "/work/fintech/", cta: "View Project", position: "50% 48%", mobile: "50% 50%" },
  { name: "Private Equity", image: "Header_Image_4", description: "A digital experience designed to inspire investor confidence.", href: "/work/private-equity/", cta: "View Project", position: "50% 48%", mobile: "78% 50%" },
];
const headline = "Building brands and intelligent digital experiences that move hearts—and move the needle.";
const headlineWords = headline.split(" ");
---

<section class="portfolio-reel" data-portfolio-reel aria-labelledby="home-two-title" aria-roledescription="carousel">
  <div class="portfolio-reel__images" aria-hidden="true">
    {slides.map((slide, index) => (
      <img
        class="portfolio-reel__image"
        data-reel-image
        src={sitePath(`/images/${slide.image}-2200.webp`)}
        srcset={`${sitePath(`/images/${slide.image}-1000.webp`)} 1000w, ${sitePath(`/images/${slide.image}-2200.webp`)} 2200w`}
        sizes="100vw"
        alt=""
        decoding="async"
        loading={index === 0 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : "auto"}
        style={`--image-position:${slide.position};--mobile-position:${slide.mobile};opacity:${index === 0 ? 1 : 0}`}
      />
    ))}
  </div>
  <div class="portfolio-reel__shade" aria-hidden="true"></div>
  <div class="container portfolio-reel__content">
    <div class="portfolio-reel__intro">
      <p class="eyebrow">Creative Direction / Design / Development</p>
      <h1 id="home-two-title">
        <span class="portfolio-reel__headline-words">
          {headlineWords.map((word, index) => (
            <span class:list={["portfolio-reel__word", { "mobile-hidden-word": word === "digital" }]} style={`--word-index:${index}`}>
              {word}<span class="portfolio-reel__word-space"> </span>
            </span>
          ))}
        </span>
      </h1>
    </div>
    <div class="portfolio-reel__footer">
      <div class="portfolio-reel__captions">
        {slides.map((slide, index) => (
          <div data-reel-caption data-entering={index === 0 ? "" : undefined} hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${slides.length}: ${slide.name}`}>
            <p class="portfolio-reel__name">{slide.name}</p>
            <p class="portfolio-reel__description">{slide.description}</p>
            <a href={sitePath(slide.href)}>{slide.cta} <OutboundArrow /></a>
          </div>
        ))}
      </div>
      <div class="portfolio-reel__controls" data-reel-controls hidden>
        <span class="portfolio-reel__count" data-reel-count aria-hidden="true">01 / 04</span>
        <button type="button" data-reel-previous aria-label="Previous project" title="Previous project"><ChevronLeft size={18} aria-hidden="true" /></button>
        <button type="button" data-reel-next aria-label="Next project" title="Next project"><ChevronRight size={18} aria-hidden="true" /></button>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountPortfolioReel } from "../../scripts/portfolio-reel";
  const reel = document.querySelector<HTMLElement>("[data-portfolio-reel]");
  if (reel) mountPortfolioReel(reel);
</script>
