<canvas class="contact-page__gradient" data-contact-gradient></canvas>

<script>
  const canvases = document.querySelectorAll<HTMLCanvasElement>("[data-contact-gradient]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  canvases.forEach((canvas) => {
    if (canvas.dataset.initialized === "true") return;
    canvas.dataset.initialized = "true";

    const gl = canvas.getContext("webgl", {
      alpha: true,
      antialias: false,
      powerPreference: "high-performance",
      premultipliedAlpha: true,
    });

    const drawFallback = () => {
      const context = canvas.getContext("2d");
      if (!context) return;
      const bounds = canvas.getBoundingClientRect();
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(bounds.width * pixelRatio);
      canvas.height = Math.round(bounds.height * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      context.clearRect(0, 0, bounds.width, bounds.height);

      const gradient = context.createLinearGradient(bounds.width, 0, bounds.width * 0.48, bounds.height);
      gradient.addColorStop(0, "rgba(50, 205, 204, 0.58)");
      gradient.addColorStop(0.3, "rgba(76, 108, 244, 0.62)");
      gradient.addColorStop(0.62, "rgba(205, 77, 201, 0.58)");
      gradient.addColorStop(1, "rgba(255, 102, 68, 0.5)");
      context.beginPath();
      context.moveTo(bounds.width * 1.06, -bounds.height * 0.06);
      context.bezierCurveTo(
        bounds.width * 0.92,
        bounds.height * 0.2,
        bounds.width * 0.7,
        bounds.height * 0.68,
        bounds.width * 0.5,
        bounds.height * 1.06,
      );
      context.strokeStyle = gradient;
      context.lineCap = "round";
      context.lineWidth = Math.max(120, Math.min(bounds.width, bounds.height) * 0.24);
      context.stroke();
    };

    if (!gl) {
      drawFallback();
      new ResizeObserver(drawFallback).observe(canvas);
      return;
    }

    const vertexSource = `
      attribute vec2 aPosition;

      void main() {
        gl_Position = vec4(aPosition, 0.0, 1.0);
      }
    `;

    const fragmentSource = `
      precision highp float;

      uniform vec2 uResolution;
      uniform vec2 uPointer;
      uniform float uTime;
      uniform float uDark;

      vec3 palette(float value) {
        vec3 coral = vec3(1.0, 0.4, 0.2667);
        vec3 pink = vec3(0.96, 0.32, 0.61);
        vec3 violet = vec3(0.47, 0.34, 0.88);
        vec3 blue = vec3(0.20, 0.43, 0.96);
        vec3 cyan = vec3(0.16, 0.78, 0.76);

        value = clamp(value, 0.0, 1.0);
        if (value < 0.25) return mix(coral, pink, value / 0.25);
        if (value < 0.5) return mix(pink, violet, (value - 0.25) / 0.25);
        if (value < 0.75) return mix(violet, blue, (value - 0.5) / 0.25);
        return mix(blue, cyan, (value - 0.75) / 0.25);
      }

      float dither(vec2 position) {
        return fract(52.9829189 * fract(dot(position, vec2(0.06711056, 0.00583715))));
      }

      void main() {
        vec2 uv = gl_FragCoord.xy / uResolution;
        uv.y = 1.0 - uv.y;

        float time = uTime * 0.14;
        float pointerShift = ((uPointer.x - 0.5) * 0.04 + (uPointer.y - 0.5) * 0.02)
          * (0.25 + uv.y);
        float center = mix(1.06, 0.52, uv.y)
          + sin((uv.y * 3.6) + time) * 0.046
          + sin((uv.y * 10.5) - (time * 0.58)) * 0.014
          + pointerShift;
        float width = 0.13
          + sin((uv.y * 4.8) - (time * 0.36)) * 0.024
          + sin((uv.y * 13.0) + time) * 0.009;
        float coordinate = (uv.x - center) / width;
        coordinate += sin((uv.y * 21.0) + (time * 1.1)) * 0.046
          + sin((uv.y * 47.0) - (time * 0.7)) * 0.018;

        float distanceFromCenter = abs(coordinate);
        float body = 1.0 - smoothstep(0.7, 1.08, distanceFromCenter);
        float glow = 1.0 - smoothstep(0.76, 1.62, distanceFromCenter);
        float mask = max(body, glow * 0.2);

        float colorPosition = clamp(
          1.0 - (uv.y * 0.82)
          + (coordinate * 0.09)
          + sin((uv.y * 5.2) - (time * 0.45)) * 0.055,
          0.0,
          1.0
        );
        vec3 color = palette(colorPosition);
        float fold = 0.5 + (0.5 * cos((coordinate * 2.9) + (uv.y * 8.0) - time));
        color *= 0.91 + (fold * 0.12);
        color += exp(-pow(coordinate * 1.7, 2.0)) * 0.065;

        float alpha = mask * mix(0.78, 0.65, uDark);

        color += (dither(gl_FragCoord.xy) - 0.5) / 255.0;
        gl_FragColor = vec4(color * alpha, alpha);
      }
    `;

    const compileShader = (type: number, source: string) => {
      const shader = gl.createShader(type);
      if (!shader) return null;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        gl.deleteShader(shader);
        return null;
      }
      return shader;
    };

    const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
    const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);
    const program = gl.createProgram();

    if (!vertexShader || !fragmentShader || !program) {
      drawFallback();
      return;
    }

    gl.attachShader(program, vertexShader);
    gl.attachShader(program, fragmentShader);
    gl.linkProgram(program);

    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      drawFallback();
      return;
    }

    const vertices = gl.createBuffer();
    const positionLocation = gl.getAttribLocation(program, "aPosition");
    const resolutionLocation = gl.getUniformLocation(program, "uResolution");
    const pointerLocation = gl.getUniformLocation(program, "uPointer");
    const timeLocation = gl.getUniformLocation(program, "uTime");
    const darkLocation = gl.getUniformLocation(program, "uDark");
    const pointer = { x: 0.5, y: 0.5, targetX: 0.5, targetY: 0.5 };
    let frame = 0;

    gl.bindBuffer(gl.ARRAY_BUFFER, vertices);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.useProgram(program);
    gl.enableVertexAttribArray(positionLocation);
    gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      const width = Math.max(1, Math.round(bounds.width * pixelRatio));
      const height = Math.max(1, Math.round(bounds.height * pixelRatio));
      if (canvas.width === width && canvas.height === height) return;
      canvas.width = width;
      canvas.height = height;
      gl.viewport(0, 0, width, height);
    };

    const draw = (time = 0) => {
      resize();
      pointer.x += (pointer.targetX - pointer.x) * 0.035;
      pointer.y += (pointer.targetY - pointer.y) * 0.035;
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform2f(resolutionLocation, canvas.width, canvas.height);
      gl.uniform2f(pointerLocation, pointer.x, pointer.y);
      gl.uniform1f(timeLocation, time * 0.001);
      gl.uniform1f(darkLocation, document.documentElement.dataset.theme === "dark" ? 1 : 0);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    const animate = (time: number) => {
      draw(time);
      frame = window.requestAnimationFrame(animate);
    };

    const updateMotion = () => {
      window.cancelAnimationFrame(frame);
      frame = 0;
      draw();
      if (!reduceMotion.matches && !document.hidden) frame = window.requestAnimationFrame(animate);
    };

    const contact = canvas.closest<HTMLElement>(".contact-page");
    contact?.addEventListener("pointermove", (event) => {
      const bounds = contact.getBoundingClientRect();
      pointer.targetX = (event.clientX - bounds.left) / bounds.width;
      pointer.targetY = (event.clientY - bounds.top) / bounds.height;
    }, { passive: true });
    contact?.addEventListener("pointerleave", () => {
      pointer.targetX = 0.5;
      pointer.targetY = 0.5;
    });

    new ResizeObserver(resize).observe(canvas);
    document.addEventListener("visibilitychange", updateMotion);
    window.addEventListener("terminel-theme-change", () => draw());
    reduceMotion.addEventListener("change", updateMotion);
    resize();
    updateMotion();
  });
</script>
