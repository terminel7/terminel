---
import { sitePath } from "../lib/paths";
import ThemeToggle from "./ThemeToggle.astro";
import OutboundArrow from "./OutboundArrow.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__meta">
      <a href={sitePath("/")} class="wordmark">terminel</a>
      <nav class="site-footer__social" aria-label="Social links">
        <ul>
          <li><a href="https://www.linkedin.com/in/angeloterminel/" rel="noreferrer">LinkedIn <OutboundArrow /></a></li>
          <li><a href="https://www.instagram.com/terminel_/" rel="noreferrer">Instagram <OutboundArrow /></a></li>
        </ul>
      </nav>
      <div class="site-footer__utility">
        <ThemeToggle />
        <span>© {year}</span>
      </div>
    </div>
  </div>
</footer>
