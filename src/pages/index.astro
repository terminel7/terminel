---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import OutboundArrow from "../components/OutboundArrow.astro";
import WorkCard from "../components/WorkCard.astro";
import { projects } from "../lib/projects";
import { sitePath } from "../lib/paths";
---

<BaseLayout bodyClass="home-page">
  <section class="home-hero section">
    <div class="home-hero__media" aria-hidden="true">
      <canvas class="home-hero__gradient" data-hero-gradient></canvas>
    </div>
    <div class="container home-hero__inner">
      <p class="eyebrow">Creative Direction / Design / Development</p>
      <h1>Building brands and intelligent <span class="mobile-hidden-word">digital </span>experiences that move hearts—and move the needle.</h1>
    </div>
  </section>

  <section class="work-preview section section--rule" id="work">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Selected Work</p>
        <p class="section-heading__meta">Case Studies</p>
      </div>
      <div class="work-grid">
        {projects.map((project, index) => <WorkCard project={project} eager={index < 2} />)}
      </div>
    </div>
  </section>

  <section class="capabilities-prompt section section--dark" data-reveal>
    <div class="container capabilities-prompt__grid">
      <p class="eyebrow">Expertise</p>
      <div>
        <p class="display-copy">Strategy, creative, branding, and development shaped as one connected system.</p>
        <a class="text-link text-link--light" href={sitePath("/capabilities/")}>Explore Capabilities <OutboundArrow /></a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-gradient]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (canvas) {
    const gl = canvas.getContext("webgl", {
      alpha: true,
      antialias: false,
      powerPreference: "high-performance",
      premultipliedAlpha: true,
    });

    const drawFallback = () => {
      const context = canvas.getContext("2d");
      if (!context) return;
      const bounds = canvas.getBoundingClientRect();
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      const portrait = bounds.width / Math.max(bounds.height, 1) < 0.72;
      canvas.width = Math.round(bounds.width * pixelRatio);
      canvas.height = Math.round(bounds.height * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      context.clearRect(0, 0, bounds.width, bounds.height);
      context.lineCap = "round";

      const fallbackColors = ["#6886ff", "#8f62ef", "#dc59d8", "#ff5f99", "#ff6644", "#ffbb45"];
      fallbackColors.forEach((color, index) => {
        const position = index / (fallbackColors.length - 1);
        context.beginPath();
        context.moveTo(bounds.width * ((portrait ? 0.2 : 0.38) + (position * (portrait ? 0.62 : 0.5))), -bounds.height * 0.1);
        context.bezierCurveTo(
          bounds.width * ((portrait ? 0.34 : 0.46) + (position * (portrait ? 0.4 : 0.28))),
          bounds.height * 0.2,
          bounds.width * ((portrait ? 0.5 : 0.68) + (position * (portrait ? 0.36 : 0.24))),
          bounds.height * 0.5,
          bounds.width * ((portrait ? 0.68 : 0.9) + (position * (portrait ? 0.3 : 0.22))),
          bounds.height,
        );
        context.strokeStyle = color;
        context.globalAlpha = 0.38;
        context.lineWidth = Math.max(bounds.width * (portrait ? 0.28 : 0.12), 60);
        context.stroke();
      });
      context.globalAlpha = 1;
    };

    if (!gl) {
      drawFallback();
      new ResizeObserver(drawFallback).observe(canvas);
    } else {
      const vertexSource = `
        attribute vec2 aPosition;

        void main() {
          gl_Position = vec4(aPosition, 0.0, 1.0);
        }
      `;

      const fragmentSource = `
        precision highp float;

        uniform vec2 uResolution;
        uniform vec2 uPointer;
        uniform float uTime;
        uniform float uDark;

        vec3 palette(float value) {
          vec3 blue = vec3(0.4078, 0.5255, 1.0);
          vec3 violet = vec3(0.5608, 0.3843, 0.9373);
          vec3 magenta = vec3(0.8627, 0.3490, 0.8471);
          vec3 pink = vec3(1.0, 0.3725, 0.6);
          vec3 orange = vec3(1.0, 0.4, 0.2667);
          vec3 gold = vec3(1.0, 0.7333, 0.2706);

          value = clamp(value, 0.0, 1.0);
          if (value < 0.2) return mix(blue, violet, value / 0.2);
          if (value < 0.4) return mix(violet, magenta, (value - 0.2) / 0.2);
          if (value < 0.6) return mix(magenta, pink, (value - 0.4) / 0.2);
          if (value < 0.8) return mix(pink, orange, (value - 0.6) / 0.2);
          return mix(orange, gold, (value - 0.8) / 0.2);
        }

        float ribbonMask(float coordinate, float softness) {
          float distanceFromCenter = abs(coordinate);
          float body = 1.0 - smoothstep(0.76, 1.05, distanceFromCenter);
          float glow = 1.0 - smoothstep(0.72, 1.38, distanceFromCenter);
          return max(body, glow * softness);
        }

        float dither(vec2 position) {
          return fract(52.9829189 * fract(dot(position, vec2(0.06711056, 0.00583715))));
        }

        void main() {
          vec2 uv = gl_FragCoord.xy / uResolution;
          uv.y = 1.0 - uv.y;

          float time = uTime * 0.22;
          float viewportAspect = uResolution.x / max(uResolution.y, 1.0);
          float portrait = 1.0 - smoothstep(0.62, 0.95, viewportAspect);
          float pointerInfluence = (uPointer.x - 0.5) * 0.055;
          float primaryCenter = mix(0.59 + (uv.y * 0.46), 0.5 + (uv.y * 0.28), portrait)
            + sin((uv.y * 3.7) + time) * 0.026
            + sin((uv.y * 8.0) - (time * 0.62)) * 0.008
            + pointerInfluence * (0.35 + uv.y);
          float primaryWidth = (0.265
            - (uv.y * 0.028)
            + sin((uv.y * 3.1) - (time * 0.45)) * 0.016)
            * mix(1.0, 1.62, portrait);
          float primaryCoordinate = (uv.x - primaryCenter) / primaryWidth;
          float primary = ribbonMask(primaryCoordinate, 0.35);

          float secondaryCenter = primaryCenter + 0.18 + sin((uv.y * 4.8) + (time * 0.7)) * 0.018;
          float secondaryCoordinate = (uv.x - secondaryCenter) / (primaryWidth * 0.7);
          float secondary = ribbonMask(secondaryCoordinate, 0.2) * 0.42;

          float colorPosition = (primaryCoordinate * 0.5) + 0.5
            + sin((uv.y * 2.7) + (time * 0.5)) * 0.055;
          vec3 primaryColor = palette(colorPosition);
          vec3 secondaryColor = palette((secondaryCoordinate * 0.5) + 0.62);
          float blend = clamp(secondary / max(primary + secondary, 0.001), 0.0, 1.0);
          vec3 color = mix(primaryColor, secondaryColor, blend);

          float broadLight = 0.985
            + sin((primaryCoordinate * 5.0) + (uv.y * 6.0) - (time * 0.65)) * 0.015;
          color *= broadLight;

          float mask = clamp(max(primary, secondary), 0.0, 1.0);
          float edgeLight = exp(-pow(primaryCoordinate * 1.8, 2.0)) * 0.08;
          color += edgeLight;
          color += (dither(gl_FragCoord.xy) - 0.5) / 255.0;
          float alpha = mask * mix(0.76, 0.68, uDark);

          gl_FragColor = vec4(color * alpha, alpha);
        }
      `;

      const compileShader = (type: number, source: string) => {
        const shader = gl.createShader(type);
        if (!shader) return null;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
          gl.deleteShader(shader);
          return null;
        }
        return shader;
      };

      const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
      const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);
      const program = gl.createProgram();

      if (!vertexShader || !fragmentShader || !program) {
        drawFallback();
      } else {
        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);

        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          drawFallback();
        } else {
          const vertices = gl.createBuffer();
          const positionLocation = gl.getAttribLocation(program, "aPosition");
          const resolutionLocation = gl.getUniformLocation(program, "uResolution");
          const pointerLocation = gl.getUniformLocation(program, "uPointer");
          const timeLocation = gl.getUniformLocation(program, "uTime");
          const darkLocation = gl.getUniformLocation(program, "uDark");
          const pointer = { x: 0.5, y: 0.5, targetX: 0.5, targetY: 0.5 };
          let frame = 0;

          gl.bindBuffer(gl.ARRAY_BUFFER, vertices);
          gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
          gl.useProgram(program);
          gl.enableVertexAttribArray(positionLocation);
          gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0);
          gl.enable(gl.BLEND);
          gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

          const resize = () => {
            const bounds = canvas.getBoundingClientRect();
            const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
            const width = Math.max(1, Math.round(bounds.width * pixelRatio));
            const height = Math.max(1, Math.round(bounds.height * pixelRatio));
            if (canvas.width === width && canvas.height === height) return;
            canvas.width = width;
            canvas.height = height;
            gl.viewport(0, 0, width, height);
          };

          const draw = (time = 0) => {
            resize();
            pointer.x += (pointer.targetX - pointer.x) * 0.035;
            pointer.y += (pointer.targetY - pointer.y) * 0.035;
            gl.clearColor(0, 0, 0, 0);
            gl.clear(gl.COLOR_BUFFER_BIT);
            gl.uniform2f(resolutionLocation, canvas.width, canvas.height);
            gl.uniform2f(pointerLocation, pointer.x, pointer.y);
            gl.uniform1f(timeLocation, time * 0.001);
            gl.uniform1f(darkLocation, document.documentElement.dataset.theme === "dark" ? 1 : 0);
            gl.drawArrays(gl.TRIANGLES, 0, 3);
          };

          const animate = (time: number) => {
            draw(time);
            frame = window.requestAnimationFrame(animate);
          };

          const updateMotion = () => {
            window.cancelAnimationFrame(frame);
            frame = 0;
            draw();
            if (!reduceMotion.matches && !document.hidden) frame = window.requestAnimationFrame(animate);
          };

          const hero = canvas.closest<HTMLElement>(".home-hero");
          hero?.addEventListener("pointermove", (event) => {
            const bounds = hero.getBoundingClientRect();
            pointer.targetX = (event.clientX - bounds.left) / bounds.width;
            pointer.targetY = (event.clientY - bounds.top) / bounds.height;
          }, { passive: true });
          hero?.addEventListener("pointerleave", () => {
            pointer.targetX = 0.5;
            pointer.targetY = 0.5;
          });

          new ResizeObserver(resize).observe(canvas);
          document.addEventListener("visibilitychange", updateMotion);
          window.addEventListener("terminel-theme-change", () => draw());
          reduceMotion.addEventListener("change", updateMotion);
          resize();
          updateMotion();
        }
      }
    }
  }
</script>
