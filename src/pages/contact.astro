---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactGradient from "../components/ContactGradient.astro";
import OutboundArrow from "../components/OutboundArrow.astro";
const year = new Date().getFullYear();
---

<BaseLayout
  title="Contact | Angelo Terminel"
  description="Start a conversation about brand, creative, or digital work."
>
  <section class="contact-page section">
    <div class="contact-page__media" aria-hidden="true">
      <ContactGradient />
    </div>
    <div class="container contact-page__inner">
      <p class="eyebrow">Contact</p>
      <h1>Start with a conversation.</h1>
      <a class="contact-page__email" href="mailto:angelo@terminel.com?subject=Hello">angelo@terminel.com <OutboundArrow /></a>
      <div class="contact-page__meta">
        <a href="https://www.linkedin.com/in/angeloterminel/" rel="noreferrer">LinkedIn <OutboundArrow /></a>
        <span>© {year}</span>
      </div>
    </div>
  </section>
</BaseLayout>
