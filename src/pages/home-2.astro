---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import OutboundArrow from "../components/OutboundArrow.astro";
import ServicesShowcase from "../components/ServicesShowcase.astro";
import { projects } from "../lib/projects";
import { sitePath } from "../lib/paths";
import "../styles/home-two-concept.css";

const projectOrder = ["streaming", "fintech", "action-sports", "auto-lending", "retail", "apparel"];
const featuredProjects = projects
  .filter((project) => projectOrder.includes(project.slug))
  .sort((a, b) => projectOrder.indexOf(a.slug) - projectOrder.indexOf(b.slug));

const heroColumns = [
  [
    "/images/work/streaming/image-02.webp",
    "/images/work/retail/image-06.webp",
    "/images/work/auto-lending/image-03.webp",
  ],
  [
    "/images/work/fintech/image-04.webp",
    "/images/work/apparel/image-01.webp",
    "/images/work/action-sports/image-05.webp",
  ],
  [
    "/images/Header_Image_4-1000.webp",
    "/images/work/streaming/image-06.webp",
    "/images/work/retail/image-09.webp",
  ],
  [
    "/images/work/auto-lending/image-06.webp",
    "/images/work/fintech/image-07.webp",
    "/images/work/apparel/image-04.webp",
  ],
  [
    "/images/work/action-sports/image-03.webp",
    "/images/work/retail/gallery-02-03.jpeg",
    "/images/work/streaming/gallery-01-04.webp",
  ],
];

const heroWordGroups = [
  ["clarity.", "attention.", "relevance.", "momentum.", "impact.", "identity.", "experience.", "growth.", "action."],
  ["transformation.", "attention.", "relevance.", "momentum.", "lasting impact.", "identity.", "experience.", "growth.", "action."],
  ["clarity.", "attention.", "relevance.", "momentum.", "impact.", "identity.", "experience.", "growth.", "action."],
];

const capabilities = [
  {
    number: "01",
    name: "Strategy",
    description: "Clarity before expression. Research, structure, and a focused point of view establish where the work should go and what it needs to accomplish.",
    items: ["Information Architecture", "Competitive Analysis", "Audience Segmentation + User Flows", "Brand + Digital Strategy", "UI/UX Strategy", "Multivariate Testing"],
    image: "/images/work/fintech/image-03.webp",
    alt: "A CU Direct publication presenting digital strategy and experience work.",
  },
  {
    number: "02",
    name: "Creative",
    description: "Ideas built to live in the real world. Direction and hands-on design connect every touchpoint, from an identity system to a campaign, product, or physical environment.",
    items: ["Web + Product Design", "Art + Creative Direction", "UX/UI Design", "Event Support + Collateral", "Design Systems", "Presentations", "Motion Graphics + Animation", "3D"],
    image: "/images/work/retail/image-06.webp",
    alt: "Hot Topic campaign photography and creative direction.",
  },
  {
    number: "03",
    name: "Branding",
    description: "Distinct identities with enough structure to stay coherent as they grow. Positioning, visual language, and practical systems make a brand easier to recognize and easier to use.",
    items: ["Logo + Identity", "Brand Standards + Evolutions", "Brand Audits", "Brand Positioning"],
    image: "/images/work/auto-lending/image-01.webp",
    alt: "CU Direct marketing style guide and brand system.",
  },
  {
    number: "04",
    name: "Development",
    description: "Digital experiences carried through to launch with thoughtful architecture, strong performance, and close attention to the original design intent.",
    items: ["Headless CMS", "Webflow", "AI Workflow Implementation", "Marketing Automation Integration", "Analytics + Reporting", "Localization + Regionalization"],
    image: "/images/work/streaming/image-06.webp",
    alt: "Responsive conference website screens across desktop layouts.",
  },
];
---

<BaseLayout
  bodyClass="home-two-concept-page"
  title="Angelo Terminel | One-page Portfolio Concept"
  description="Creative direction, design, strategy, and development across brands and digital experiences."
  hideGlobalNavigation
>
  <header class="concept-header" data-concept-header data-scrolled="false">
    <div class="container concept-header__inner">
      <a class="concept-header__wordmark" href="#top" aria-label="Angelo Terminel, back to top">Angelo Terminel</a>
      <nav aria-label="One-page navigation">
        <ul>
          <li><a href="#work" data-section-link="work">Work</a></li>
          <li><a href="#capabilities" data-section-link="capabilities">Capabilities</a></li>
          <li><a href="#contact" data-section-link="contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <section
    class="concept-hero built-header-section"
    id="top"
    aria-labelledby="concept-hero-title"
    data-concept-hero
    data-built-hero
  >
    <div class="built-hero-speaker-container" aria-hidden="true">
      <div class="built-hero-speaker-block">
        {heroColumns.map((column) => (
          <div class="built-hero-speaker-column">
            {column.map((image) => (
              <img
                class="built-hero-speaker"
                src={sitePath(image)}
                alt=""
                width="211"
                height="362"
                loading="eager"
                decoding="async"
              />
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="built-header-list">
      <h1
        id="concept-hero-title"
        class="built-h1-lockup"
        aria-label="Built for clarity, attention, relevance, momentum, identity, experience, growth, action, transformation, and lasting impact."
      >
        <span class="built-h1 h1" aria-hidden="true">Built for</span>
        <span class="built-h1 h1 this hidden" aria-hidden="true">this.</span>
      </h1>

      <div class="built-hero-list" aria-hidden="true">
        <span class="built-h1 hidden">Built for</span>
        <div class="built-hero-list-wrap">
          <div class="built-h1-list-items">
            {heroWordGroups.map((group, groupIndex) => (
              <div>
                {group.map((word, wordIndex) => (
                  <div
                    class:list={{
                      "built-h1": true,
                      "list-item": !(groupIndex === 0 && wordIndex === 4),
                      h1: groupIndex === 0 && wordIndex === 4,
                      this: (groupIndex === 0 || groupIndex === 2) && wordIndex === 4,
                    }}
                  >
                    {word}
                  </div>
                ))}
              </div>
            ))}
          </div>
          <span class="built-h1 hidden">this.</span>
        </div>
      </div>
    </div>

    <div class="built-header-content container">
      <div class="built-header-txt-block">
        <p>
          Projects are rarely short on possibility. The real work is finding the clearest idea, then carrying it through strategy, creative direction, design, and development without losing the thread.
          <br /><br />
          <strong>Built to hold attention.<br />Built to create impact.</strong>
        </p>
        <div class="built-cta-block">
          <a class="built-cta built-cta--primary" href="#work">Explore Selected Work</a>
          <a class="built-cta built-cta--secondary" href="#capabilities">View Capabilities</a>
        </div>
      </div>
    </div>
  </section>

  <section class="concept-work" id="work" aria-labelledby="concept-work-title">
    <div class="container">
      <header class="concept-section-intro">
        <p class="eyebrow">Selected Work</p>
        <div>
          <h2 id="concept-work-title">A collection shaped across industries, audiences, and mediums.</h2>
          <p>Brand systems, websites, campaigns, events, and products brought together by a clear idea and careful execution.</p>
        </div>
      </header>

      <div class="concept-work__grid">
        {featuredProjects.map((project, index) => (
          <article class="concept-work-card" data-reveal>
            <a href={sitePath(`/work/${project.slug}/`)}>
              <figure class="concept-work-card__media">
                <img
                  src={sitePath(project.thumbnail)}
                  alt=""
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </figure>
              <div class="concept-work-card__content">
                <span class="concept-work-card__number">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <p class="concept-work-card__industry">{project.name}</p>
                  <h3>{project.title}</h3>
                  <ul aria-label="Services">
                    {project.services.map((service) => <li>{service}</li>)}
                  </ul>
                </div>
                <OutboundArrow className="concept-work-card__arrow" />
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ServicesShowcase id="capabilities" />

  <section class="concept-capabilities" aria-labelledby="concept-capabilities-title">
    <div class="container concept-capabilities__layout">
      <header class="concept-capabilities__intro">
        <p class="eyebrow">Capabilities</p>
        <h2 id="concept-capabilities-title">A connected practice from first question to final expression.</h2>
        <p>Disciplines overlap by design, creating continuity from the thinking behind the work to the details that make it perform.</p>
      </header>

      <div class="concept-capabilities__list">
        {capabilities.map((capability) => (
          <article class="concept-capability" data-reveal>
            <div class="concept-capability__heading">
              <span>{capability.number}</span>
              <h3>{capability.name}</h3>
            </div>
            <figure class="concept-capability__media">
              <img
                src={sitePath(capability.image)}
                alt={capability.alt}
                width="1600"
                height="900"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="concept-capability__body">
              <p>{capability.description}</p>
              <ul>
                {capability.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="concept-contact" id="contact" aria-labelledby="concept-contact-title">
    <div class="container concept-contact__layout">
      <header class="concept-contact__intro">
        <p class="eyebrow">Contact</p>
        <h2 id="concept-contact-title">Start with a conversation.</h2>
        <p>Share what is taking shape, what needs to change, or where the next move still feels unclear.</p>
      </header>

      <form class="contact-form concept-contact__form" action="/api/contact" method="post" data-contact-form novalidate>
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="home-two-name">Name</label>
            <input id="home-two-name" name="name" type="text" autocomplete="name" maxlength="100" required />
          </div>
          <div class="contact-form__field">
            <label for="home-two-email">Email</label>
            <input id="home-two-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>
        </div>
        <div class="contact-form__field">
          <label for="home-two-subject">Subject</label>
          <input id="home-two-subject" name="subject" type="text" maxlength="160" required />
        </div>
        <div class="contact-form__field">
          <label for="home-two-message">Message</label>
          <textarea id="home-two-message" name="message" rows="6" maxlength="5000" required></textarea>
        </div>
        <div class="contact-form__trap" aria-hidden="true">
          <label for="home-two-company">Company website</label>
          <input id="home-two-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="contact-form__footer">
          <button type="submit" data-contact-submit>Send Message</button>
          <p class="contact-form__status" role="status" aria-live="polite" data-contact-status></p>
        </div>
      </form>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  import { gsap } from "gsap";

  const conceptHeader = document.querySelector<HTMLElement>("[data-concept-header]");
  const conceptHero = document.querySelector<HTMLElement>("[data-concept-hero]");

  if (conceptHero) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const initialLockup = conceptHero.querySelectorAll<HTMLElement>(".built-h1.h1");
    const listItems = conceptHero.querySelectorAll<HTMLElement>(".built-h1.list-item");
    const speakerImages = conceptHero.querySelectorAll<HTMLElement>(".built-hero-speaker");
    const textBlock = conceptHero.querySelector<HTMLElement>(".built-header-txt-block");

    const animatedElements = [
      ...initialLockup,
      ...listItems,
      ...speakerImages,
      ...(textBlock ? [textBlock] : []),
    ];

    gsap.set(animatedElements, { visibility: "visible" });

    if (reducedMotion) {
      gsap.set(conceptHero.querySelector(".built-hero-list"), { display: "none" });
      gsap.set(animatedElements, { clearProps: "transform,opacity" });
      gsap.set(conceptHero.querySelector(".built-h1.h1.this"), { opacity: 1 });
    } else {
      const intro = gsap.timeline();

      intro.from(initialLockup, {
        opacity: 0,
        duration: 0.75,
        stagger: { each: 0.05, ease: "power1.out", from: "start" },
        ease: "power3.in",
      }, 0);

      intro.from(listItems, {
        opacity: 0,
        xPercent: 40,
        duration: 1.32,
        stagger: { each: 0.05, from: "start" },
        ease: "expo.out",
      }, 1.45);

      intro.from(listItems, {
        yPercent: 900,
        duration: 2.82,
      }, 0);

      intro.fromTo(listItems, {
        yPercent: 900,
      }, {
        yPercent: -900,
        duration: 8.16,
        stagger: { each: 0.03 },
        ease: "power4.inOut",
      }, 2.76);

      intro.fromTo(textBlock, {
        opacity: 0,
      }, {
        opacity: 1,
        duration: 1.31,
        ease: "power3.in",
      }, 2.59);

      intro.fromTo(speakerImages, {
        opacity: 0,
      }, {
        opacity: 1,
        duration: 2.93,
        stagger: { each: 0.25 },
        ease: "power3.in",
      }, 0.52);
    }
  }

  const updatePageMotion = () => {
    const scrollTop = window.scrollY;
    const heroHeight = conceptHero?.offsetHeight ?? window.innerHeight;

    if (conceptHeader) {
      conceptHeader.dataset.scrolled = String(scrollTop > Math.max(80, heroHeight * 0.72));
    }

    if (scrollTop < heroHeight * 0.55) {
      document.querySelectorAll<HTMLElement>("[data-section-link]").forEach((link) => {
        link.removeAttribute("aria-current");
      });
    }
  };

  let motionFrame = 0;
  const requestPageMotion = () => {
    if (motionFrame) return;
    motionFrame = window.requestAnimationFrame(() => {
      updatePageMotion();
      motionFrame = 0;
    });
  };

  updatePageMotion();
  window.addEventListener("scroll", requestPageMotion, { passive: true });
  window.addEventListener("resize", requestPageMotion, { passive: true });

  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-section-link]"));
  const sections = sectionLinks
    .map((link) => document.getElementById(link.dataset.sectionLink ?? ""))
    .filter((section): section is HTMLElement => Boolean(section));

  if ("IntersectionObserver" in window) {
    const sectionObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

      if (!visible) return;
      sectionLinks.forEach((link) => {
        const current = link.dataset.sectionLink === visible.target.id;
        if (current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }, { rootMargin: "-25% 0px -55%", threshold: [0, 0.2, 0.5] });

    sections.forEach((section) => sectionObserver.observe(section));
  }

  const forms = document.querySelectorAll<HTMLFormElement>("[data-contact-form]");

  forms.forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>("[data-contact-submit]");
    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    let startedAt = Date.now();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (!submit || !status) return;

      submit.disabled = true;
      submit.textContent = "Sending...";
      form.setAttribute("aria-busy", "true");
      status.dataset.state = "";
      status.textContent = "";

      const payload = {
        ...Object.fromEntries(new FormData(form).entries()),
        startedAt: String(startedAt),
      };

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) throw new Error(result.message || "Unable to send your message.");

        form.reset();
        startedAt = Date.now();
        status.dataset.state = "success";
        status.textContent = result.message || "Thanks. Your message is on its way.";
      } catch (error) {
        status.dataset.state = "error";
        status.textContent = error instanceof Error
          ? error.message
          : "Unable to send your message. Please try again.";
      } finally {
        submit.disabled = false;
        submit.textContent = "Send Message";
        form.removeAttribute("aria-busy");
      }
    });
  });
</script>
